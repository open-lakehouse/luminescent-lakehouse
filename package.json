{
  "name": "luminescent-lakehouse",
  "private": true,
  "description": "Deploy tooling (neon.ts and the pinned Neon CLI) plus the apps/ workspaces. The functions themselves have no npm dependencies.",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "postinstall": "[ ! -f scripts/strip-bun-lock-proxy.ts ] || bun run scripts/strip-bun-lock-proxy.ts",
    "strip-lock-proxy": "bun run scripts/strip-bun-lock-proxy.ts",
    "strip-lock-proxy:check": "bun run scripts/strip-bun-lock-proxy.ts --check"
  },
  "devDependencies": {
    "@neon/config": "1.10.0",
    "neon": "8.16.0"
  },
  "overrides": {
    "@open-lakehouse/arrow-grid": "https://github.com/open-lakehouse/mangrove/releases/download/arrow-grid-v0.0.1/open-lakehouse-arrow-grid-0.0.1.tgz",
    "@open-lakehouse/lineage-client": "https://github.com/open-lakehouse/headwaters/releases/download/lineage-client-v0.0.2/open-lakehouse-lineage-client-0.0.2.tgz",
    "@open-lakehouse/stack-wasm": "https://github.com/open-lakehouse/trestle/releases/download/stack-wasm-v0.0.4/open-lakehouse-stack-wasm-0.0.4.tgz",
    "@open-lakehouse/ui-kit": "https://github.com/open-lakehouse/trestle/releases/download/ui-kit-v0.0.1/open-lakehouse-ui-kit-0.0.1.tgz"
  }
}
