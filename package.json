{
  "name": "luminescent-lakehouse",
  "private": true,
  "description": "Deploy tooling (neon.ts and the pinned Neon CLI) plus the apps/ workspaces. The functions themselves have no npm dependencies.",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "postinstall": "[ ! -f scripts/strip-bun-lock-proxy.ts ] || bun run scripts/strip-bun-lock-proxy.ts",
    "strip-lock-proxy": "bun run scripts/strip-bun-lock-proxy.ts",
    "strip-lock-proxy:check": "bun run scripts/strip-bun-lock-proxy.ts --check"
  },
  "devDependencies": {
    "@neon/config": "1.10.0",
    "neon": "8.16.0"
  }
}
