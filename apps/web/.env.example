# Only for the older /b/<endpoint-id>/… pages: a branch's Auth URL is
#   https://<endpoint-id>.<VITE_NEON_AUTH_HOST_SUFFIX>/<VITE_NEON_AUTH_DB>/auth
# The /a/<auth-host>/<db>/… pages need no configuration. Copy to .env.local for
# `just web-dev`; on Vercel, both are set for every environment (docs/web.md).
VITE_NEON_AUTH_HOST_SUFFIX=neonauth.c-7.eu-central-1.aws.neon.tech
VITE_NEON_AUTH_DB=neondb
