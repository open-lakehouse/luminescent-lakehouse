# A Neon branch's Auth URL is
#   https://<endpoint-id>.<VITE_NEON_AUTH_HOST_SUFFIX>/<VITE_NEON_AUTH_DB>/auth
# and the endpoint id comes from the path (/b/<endpoint-id>/…), so one build
# serves every branch of the project. Copy to .env.local for `just web-dev`;
# on Vercel, set both for every environment (docs/web.md).
VITE_NEON_AUTH_HOST_SUFFIX=neonauth.c-7.eu-central-1.aws.neon.tech
VITE_NEON_AUTH_DB=neondb
