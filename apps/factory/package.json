{
  "name": "@open-lakehouse/factory-app",
  "version": "0.0.0",
  "private": true,
  "description": "The factory control room as a standalone web app, against factory-server",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6010",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@open-lakehouse/editor": "https://github.com/open-lakehouse/mangrove/releases/download/editor-v0.0.2/open-lakehouse-editor-0.0.2.tgz",
    "@open-lakehouse/factory-client": "workspace:*",
    "@open-lakehouse/factory-ui": "workspace:*",
    "@open-lakehouse/host": "https://github.com/open-lakehouse/trestle/releases/download/host-v0.0.2/open-lakehouse-host-0.0.2.tgz",
    "@open-lakehouse/ui-kit": "https://github.com/open-lakehouse/trestle/releases/download/ui-kit-v0.0.3/open-lakehouse-ui-kit-0.0.3.tgz",
    "@tanstack/react-query": "^5.105.0",
    "@xyflow/react": "^12.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.8.3",
    "vite": "^8.1.3"
  }
}
