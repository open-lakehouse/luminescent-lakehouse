  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "factory-source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test --conditions=factory-source"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.6.0",
    "@connectrpc/connect": "^2.1.2",
    "@monaco-editor/react": "^4.7.0",
    "@open-lakehouse/factory-client": "workspace:*",
    "@tanstack/react-query": "^5.105.0",
    "@xyflow/react": "^12.4.0",
    "elkjs": "^0.11.0",
    "lucide-react": "^1.23.0",
    "monaco-editor": "0.54.0"
  },
  "peerDependencies": {
    "@open-lakehouse/editor": "0.0.2",
    "@open-lakehouse/host": "0.0.2",
    "@open-lakehouse/ui-kit": "0.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@happy-dom/global-registrator": "^21.0.4",
    "@open-lakehouse/editor": "https://github.com/open-lakehouse/mangrove/releases/download/editor-v0.0.2/open-lakehouse-editor-0.0.2.tgz",
    "@open-lakehouse/host": "https://github.com/open-lakehouse/trestle/releases/download/host-v0.0.2/open-lakehouse-host-0.0.2.tgz",
    "@open-lakehouse/ui-kit": "https://github.com/open-lakehouse/trestle/releases/download/ui-kit-v0.0.1/open-lakehouse-ui-kit-0.0.1.tgz",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.3"
  }
