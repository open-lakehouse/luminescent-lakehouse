{
  "name": "@open-lakehouse/factory-plan-review",
  "version": "0.0.0",
  "private": true,
  "description": "Plan review as an MCP App: the ui://factory/plan view workgraph-mcp serves, one inline HTML document with no network",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "sync": "bun run scripts/sync.ts",
    "sync:check": "bun run scripts/sync.ts --check",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test --conditions=factory-source"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.6.0",
    "@connectrpc/connect": "^2.1.2",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@open-lakehouse/factory-client": "workspace:*",
    "@open-lakehouse/factory-ui": "workspace:*",
    "@open-lakehouse/host": "https://github.com/open-lakehouse/trestle/releases/download/host-v0.0.2/open-lakehouse-host-0.0.2.tgz",
    "@open-lakehouse/ui-kit": "https://github.com/open-lakehouse/trestle/releases/download/ui-kit-v0.0.1/open-lakehouse-ui-kit-0.0.1.tgz",
    "@tanstack/react-query": "^5.105.0",
    "@xyflow/react": "^12.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@happy-dom/global-registrator": "^21.0.4",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.8.3",
    "vite": "^8.1.3",
    "vite-plugin-singlefile": "2.3.4"
  }
}
