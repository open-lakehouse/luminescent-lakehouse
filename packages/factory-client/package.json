{
  "name": "@open-lakehouse/factory-client",
  "version": "0.0.0",
  "private": true,
  "description": "The generated ConnectRPC client and types for factory.v1, bound through the @open-lakehouse/host contract",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-lakehouse/luminescent-lakehouse.git",
    "directory": "packages/factory-client"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "factory-source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "factory-source": "./src/testing.ts",
      "types": "./src/testing.ts",
      "import": "./dist/testing.js"
    }
  },
  "scripts": {
    "gen": "buf generate",
    "build": "bun ../scripts/build-package.ts",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test --conditions=factory-source"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.6.0",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-web": "^2.1.2"
  },
  "peerDependencies": {
    "@open-lakehouse/host": "0.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@bufbuild/protoc-gen-es": "^2.6.0",
    "@open-lakehouse/host": "https://github.com/open-lakehouse/trestle/releases/download/host-v0.0.2/open-lakehouse-host-0.0.2.tgz",
    "@types/bun": "^1.3.14",
    "typescript": "^5.8.3"
  }
}
